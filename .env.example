NODE_ENV=development
SUPABASE_URL=https://vpvhshoxwaorrwtaxvdb.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://vpvhshoxwaorrwtaxvdb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → Database → Connect. Prefer the session pooler (IPv4) from this network; transaction pooler is port 6543.
DATABASE_URL=postgresql://postgres.vpvhshoxwaorrwtaxvdb:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Local fallback: postgres://oyokometa:oyokometa@localhost:5432/oyokometa
INLINE_WORKER=true
STORAGE_DRIVER=fs
FS_STORAGE_DIR=./data/storage
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=oyokometa-assets
# S3_ACCESS_KEY=oyokometa
# S3_SECRET_KEY=oyokometa-secret
# S3_FORCE_PATH_STYLE=true
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://localhost:4000
SESSION_SECRET=change-me-to-a-32-byte-secret-value!!
SIGNING_PRIVATE_KEY_PEM=
SIGNING_KEY_ID=okm-dev-1
SIGNING_PUBLIC_KEY_PEM=
AWS_KMS_KEY_ID=
TSA_URL=
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
AI_LABELS_ENABLED=false
# C2PA 2.3 Reader (API/worker). Default Trust List config is fetched by the official SDK.
# C2PA_TRUST_CONFIG=https://caoclist.adobe.com/config.cfg
# C2PA_TRUST_LIST_VERSION=
RULESET_VERSION=ruleset-1.0.0
