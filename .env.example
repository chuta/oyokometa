# Production web: NEXT_PUBLIC_API_URL=https://oyokometa-api.fly.dev
AUTH_SECRET=change-me-auth-secret-at-least-32-chars
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_FROM=Oyokometa <noreply@localhost>
