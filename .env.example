NODE_ENV=development
SUPABASE_URL=https://vpvhshoxwaorrwtaxvdb.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://vpvhshoxwaorrwtaxvdb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → Database → Connect. Prefer the session pooler (IPv4) from this network; transaction pooler is port 6543.
DATABASE_URL=postgresql://postgres.vpvhshoxwaorrwtaxvdb:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Local fallback: postgres://oyokometa:oyokometa@localhost:5432/oyokometa
INLINE_WORKER=true
STORAGE_DRIVER=fs
FS_STORAGE_DIR=./data/storage
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=oyokometa-assets
# S3_ACCESS_KEY=oyokometa
# S3_SECRET_KEY=oyokometa-secret
# S3_FORCE_PATH_STYLE=true
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://localhost:4000
SESSION_SECRET=change-me-to-a-32-byte-secret-value!!
# Signing. Production needs AWS_KMS_KEY_ID + SIGNING_PUBLIC_KEY_PEM; an env PEM is refused there
# unless SIGNING_ALLOW_ENV_KEY=true (temporary exception). Development generates data/signing-dev.pem.
SIGNING_PRIVATE_KEY_PEM=
SIGNING_KEY_ID=okm-dev-1
# SIGNING_KEY_VALID_FROM=2026-10-01T00:00:00.000Z
SIGNING_PUBLIC_KEY_PEM=
AWS_KMS_KEY_ID=
# AWS_REGION=eu-west-1
# Credentials for the sign-only IAM user (infra/aws/signing-key.yaml). Locally, AWS_PROFILE works instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SIGNING_ALLOW_ENV_KEY=false
# Public keys of earlier signing keys, so old records keep verifying. Generate with
# `pnpm --filter @oyokometa/api signing:retired-key`.
# SIGNING_RETIRED_KEYS_JSON=[]
# RFC 3161 timestamps. Required in production; development uses a labelled platform clock when unset.
TSA_URL=
# TSA_URL=http://timestamp.digicert.com
# TSA_TIMEOUT_MS=15000
# Malware scanning. Required in production (fails closed); optional in development.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
# MALWARE_SCAN_REQUIRED=false
# Hourly retention job in the API process (set false to disable, e.g. in tests).
# RETENTION_JOB=true
# Local AI-image detector (Fly private app). Quick Scan and Deep Analysis.
# DETECTOR_URL=http://oyokometa-detector.internal:8080
# DETECTOR_AUTH_TOKEN=
# Sightengine, Deep Analysis only. One call runs genai and deepfake. Never the Feedback API.
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# Reality Defender, Deep Analysis images only. Ensemble score. No social links and no feedback.
# REALITYDEFENDER_API_KEY=
AI_LABELS_ENABLED=false
# C2PA 2.3 Reader (API/worker). The worker downloads the official trust list and the
# frozen interim list into this directory and passes the local PEM path to c2pa-node.
# On Fly this is /data/c2pa-trust (the okm_data volume). c2pa-node does not fetch URLs.
# C2PA_TRUST_DIR=
# C2PA_TRUST_LIST_VERSION=
RULESET_VERSION=ruleset-1.0.0
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production web: NEXT_PUBLIC_API_URL=https://oyokometa-api.fly.dev
AUTH_SECRET=change-me-auth-secret-at-least-32-chars
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_FROM=Oyokometa <noreply@localhost>
# Resend: verify the EMAIL_FROM domain, then set RESEND_API_KEY. Magic links, dispute
# confirmations, report links and bank-transfer instructions go through Resend.
ADMIN_EMAIL=you@example.com
BANK_NAME=Example Bank
BANK_ACCOUNT_NAME=Oyokometa Ltd
BANK_ACCOUNT_NUMBER=0123456789
BANK_CURRENCY=NGN
RESEND_API_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Bachs. sk_sandbox_ uses https://sandbox-api.bachs.io. sk_live_ uses https://api.bachs.io.
# BACHS_MODE=sandbox uses BACHS_API_Test_KEY and BACHS_WEBHOOK_TEST_SECRET.
# Leave BACHS_MODE unset, or set live, to use BACHS_API_KEY and BACHS_WEBHOOK_SECRET.
BACHS_MODE=
BACHS_API_KEY=
BACHS_API_Test_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_WEBHOOK_TEST_SECRET=
NIPOST_API_KEY=
